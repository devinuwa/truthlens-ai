# Copy to .env.local. Do not commit real keys.

# Supabase project URL and the anon (publishable) key. Safe to expose to the browser.
# Leave blank to run guest checks without accounts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Used for admin opportunity inserts. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails allowed to add opportunities through /api/admin/opportunities.
ADMIN_EMAILS=

# Optional FastAPI model service, for example http://127.0.0.1:8000
# When set, message and link text is also sent to that service.
# Gemma is used instead when GEMINI_API_KEY is set.
TRUTHLENS_ML_URL=

# Server only. Google AI Studio key for the Gemma 4 reading.
# This is not the Gmail OAuth client id or secret. Never prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Optional. Use gemma-4-26b-a4b-it. gemma-4-31b-it is allowed, but a test call took too long for the site timeout.
GOOGLE_GEMMA_MODEL=

# Optional. Groq Cloud key for the reading. Server only. Never prefix with NEXT_PUBLIC_.
# Used when TRUTHLENS_AI_PROVIDER=groq, or when no Gemini key is set.
GROQ_API_KEY=

# Optional. A current Groq production chat model. Default llama-3.3-70b-versatile.
# Also allowed: llama-3.1-8b-instant, openai/gpt-oss-20b, openai/gpt-oss-120b.
GROQ_MODEL=

# Optional. gemini, groq, or auto. auto uses Gemini when GEMINI_API_KEY is set.
TRUTHLENS_AI_PROVIDER=

# Public site URL used in documentation and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
